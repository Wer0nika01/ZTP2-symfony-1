{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_list'|trans }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.tag_list'|trans }}</h1>
            <a href="{{ path('tag_create') }}" class="btn btn-primary">
                {{ 'action.create_tag'|trans }}
            </a>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.title'|trans }}</th>
                    <th>{{ 'label.slug'|trans }}</th>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <th>{{ 'label.updated_at'|trans }}</th>
                    <th>{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for tag in pagination.items %}
                    <tr>
                        <td>{{ tag.id }}</td>
                        <td>{{ tag.title }}</td>
                        <td>{{ tag.slug }}</td>
                        <td>{{ tag.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ tag.updatedAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <a href="{{ path('tag_edit', {id: tag.id}) }}" class="btn btn-sm btn-secondary">
                                {{ 'action.edit'|trans }}
                            </a>
                            <form method="post" action="{{ path('tag_delete', {id: tag.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'message.confirm_delete'|trans }}');">
                                <input type="hidden" name="_method" value="DELETE">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                <button class="btn btn-sm btn-danger">
                                    {{ 'action.delete'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
