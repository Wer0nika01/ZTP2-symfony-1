{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_list'|trans }}
{% endblock %}

{% block body %}
    {% set showActions = false %}
    {% for tag in pagination %}
        {% if is_granted('TAG_VIEW', tag) %}
            {% set showActions = true %}
        {% endif %}
    {% endfor %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.tag_list'|trans }}</h1>
            {% if is_granted('TAG_CREATE') %}
                <a href="{{ path('tag_create') }}" class="btn btn-primary">
                    {{ 'action.create'|trans }}
                </a>
            {% endif %}
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.title'|trans }}</th>
                    <th>{{ 'label.slug'|trans }}</th>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <th>{{ 'label.updated_at'|trans }}</th>
                    {% if showActions %}
                        <th>{{ 'label.actions'|trans }}</th>
                    {% endif %}
                </tr>
                </thead>
                <tbody>
                {% for tag in pagination.items %}
                    <tr>
                        <td>{{ tag.id }}</td>
                        <td>{{ tag.title }}</td>
                        <td>{{ tag.slug }}</td>
                        <td>{{ tag.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ tag.updatedAt|date('Y-m-d H:i') }}</td>
                        {% if showActions %}
                            <td>
                                {% if is_granted('TAG_VIEW', tag) %}
                                    <a class="btn btn-outline-primary" href="{{ url('tag_view', {id: tag.id}) }}" title="{{ 'action.show'|trans }}">
                                        {{ 'action.show'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('TAG_EDIT', tag) %}
                                    <a class="btn btn-outline-success" href="{{ url('tag_edit', {id: tag.id}) }}" title="{{ 'action.edit'|trans }}">
                                        {{ 'action.edit'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('TAG_DELETE', tag) %}
                                    <a class="btn btn-outline-danger" href="{{ url('tag_delete', {id: tag.id}) }}" title="{{ 'action.delete'|trans }}">
                                        {{ 'action.delete'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
