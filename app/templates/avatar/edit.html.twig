{# templates/avatar/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ 'title.edit_avatar'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.edit_avatar'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.file) }}

    <button class="btn btn-primary" type="submit">{{ 'action.save'|trans }}</button>
    <a href="{{ path('app_profile') }}" class="btn btn-secondary">{{ 'action.cancel'|trans }}</a>

    {{ form_end(form) }}

    <hr>

    <form method="post" action="{{ path('avatar_delete', {'id': avatar.id}) }}" onsubmit="return confirm('{{ 'message.delete_confirm'|trans }}');" style="display:inline-block;">
        <input type="hidden" name="_method" value="DELETE">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avatar.id) }}"> {# Ważne: użyj unikalnego ID dla tokena, np. 'delete'~avatar.id #}
        <button class="btn btn-danger">{{ 'action.delete'|trans }}</button>
    </form>



{% endblock %}