{% extends 'base.html.twig' %}

{% block title %}{{ 'title.avatar_create'|trans }}{% endblock %}

{% block body %}
<h1>{{ 'title.avatar_create'|trans }}</h1>

{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
{{ form_row(form.file) }}

<button class="btn btn-primary">{{ 'action.save'|trans }}</button>
    <a href="{{ path('dashboard_index') }}" class="btn btn-secondary">
        {{ 'action.back_to_list'|trans }}
    </a>
{{ form_end(form) }}

{% endblock %}
