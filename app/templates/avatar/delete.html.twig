{% extends 'base.html.twig' %}

{% block title %}{{ 'title.delete_avatar'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.delete_avatar'|trans }}</h1>

    {{ form_start(form) }}
    <button class="btn btn-danger" type="submit">{{ 'action.delete'|trans }}</button>
    <a href="{{ path('app_profile') }}" class="btn btn-secondary">{{ 'action.cancel'|trans }}</a>
    {{ form_end(form) }}
{% endblock %}
