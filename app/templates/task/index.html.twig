{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.task_list'|trans }}
{% endblock %}

{% block body %}
    {% set showActions = false %}
    {% for task in pagination %}
        {% if is_granted('TASK_VIEW', task) %}
            {% set showActions = true %}
        {% endif %}
    {% endfor %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.task_list'|trans }}</h1>
            <a href="{{ path('task_create') }}" class="btn btn-primary">
                {{ 'action.create'|trans }}
            </a>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}

        <div class="text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ 'label.id'|trans }}</th>
                <th>{{ 'label.name'|trans }}</th>
                <th>{{ 'label.created_at'|trans }}</th>
                <th>{{ 'label.updated_at'|trans }}</th>
                <th>{{ 'label.category'|trans }}</th>
                <th>{{ 'label.tags'|trans }}</th>
                {% if showActions %}
                    <th>{{ 'label.actions'|trans }}</th>
                {% endif %}

            </tr>
            </thead>
            <tbody>
            {% for task in pagination.items %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td>{{ task.title }}</td>
                    <td>{{ task.createdAt|format_date('long') }}</td>
                    <td>{{ task.updatedAt|format_date('long') }}</td>
                    <td>{{ task.category.title }}</td>
                    <td>
                        {% if task.tags is not empty %}
                            {% for tag in task.tags %}
                                <span class="badge bg-secondary">{{ tag.title }}</span>
                            {% endfor %}
                        {% else %}
                            <em>{{ 'label.no_tags'|trans }}</em>
                        {% endif %}
                    </td>
                    {% if showActions %}
                        <td>
                            {% if is_granted('TASK_VIEW', task) %}
                                <a class="btn btn-outline-primary" href="{{ url('task_view', {id: task.id}) }}" title="{{ 'action.show'|trans }}">
                                    {{ 'action.show'|trans }}
                                </a>
                            {% endif %}
                            {% if is_granted('TASK_EDIT', task) %}
                                <a class="btn btn-outline-success" href="{{ url('task_edit', {id: task.id}) }}" title="{{ 'action.edit'|trans }}">
                                    {{ 'action.edit'|trans }}
                                </a>
                            {% endif %}
                            {% if is_granted('TASK_DELETE', task) %}
                                <a class="btn btn-outline-danger" href="{{ url('task_delete', {id: task.id}) }}" title="{{ 'action.delete'|trans }}">
                                    {{ 'action.delete'|trans }}
                                </a>
                            {% endif %}
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    </div>
{% endblock %}