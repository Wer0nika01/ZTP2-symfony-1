{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.task_list'|trans }}
{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.task_list'|trans }}</h1>
            <a href="{{ path('task_create') }}" class="btn btn-primary">
                {{ 'action.create'|trans }}
            </a>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}

        <div class="text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ 'label.id'|trans }}</th>
                <th>{{ 'label.name'|trans }}</th>
                <th>{{ 'label.created_at'|trans }}</th>
                <th>{{ 'label.updated_at'|trans }}</th>
                <th>{{ 'label.category'|trans }}</th>
                <th>{{ 'label.tags'|trans }}</th>
                <th>{{ 'label.actions'|trans }}</th>

            </tr>
            </thead>
            <tbody>
            {% for task in pagination.items %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td>
                        <a href="{{ path('task_view', { id: task.id }) }}">
                            {{ task.title }}
                        </a>
                    </td>
                    <td>{{ task.createdAt|format_date('long') }}</td>
                    <td>{{ task.updatedAt|format_date('long') }}</td>
                    <td>{{ task.category.title }}</td>
                    <td>
                        {% if task.tags is not empty %}
                            {% for tag in task.tags %}
                                <span class="badge bg-secondary">{{ tag.title }}</span>
                            {% endfor %}
                        {% else %}
                            <em>{{ 'label.no_tags'|trans }}</em>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('task_edit', { id: task.id }) }}" class="btn btn-sm btn-secondary">
                            {{ 'action.edit'|trans }}
                        </a>
                        <a href="{{ path('task_delete', { id: task.id }) }}" class="btn btn-sm btn-danger">
                            {{ 'action.delete'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
    </div>
{% endblock %}