{% extends 'base.html.twig' %}

{% block title %}{{ 'title.category_list'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.category_list'|trans }}</h1>
            <a href="{{ path('category_create') }}" class="btn btn-primary">
                {{ 'action.create'|trans }}
            </a>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.name'|trans }}</th>
                    <th>{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for category in pagination %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>
                            <a href="{{ path('category_view', { id: category.id }) }}">
                                {{ category.title }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('category_edit', { id: category.id }) }}" class="btn btn-sm btn-secondary">
                                {{ 'action.edit'|trans }}
                            </a>
                            <a href="{{ path('category_delete', { id: category.id }) }}" class="btn btn-sm btn-danger">
                                {{ 'action.delete'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
