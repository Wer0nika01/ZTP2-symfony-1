{% extends 'base.html.twig' %}

{% block title %}{{ 'title.category_list'|trans }}{% endblock %}

{% block body %}
    {% set showActions = false %}
    {% for category in pagination %}
        {% if is_granted('CATEGORY_VIEW', category) %}
            {% set showActions = true %}
        {% endif %}
    {% endfor %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.category_list'|trans }}</h1>
            {% if is_granted('CATEGORY_CREATE') %}
                <a href="{{ path('category_create') }}" class="btn btn-primary">
                    {{ 'action.create'|trans }}
                </a>
            {% endif %}
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}

            <div class="text-center mb-3">
                {{ knp_pagination_render(pagination) }}
            </div>

            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.name'|trans }}</th>
                    {% if showActions %}
                        <th>{{ 'label.actions'|trans }}</th>
                    {% endif %}
                </tr>
                </thead>
                <tbody>
                {% for category in pagination %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.title }}</td>
                        {% if showActions %}
                            <td>
                                {% if is_granted('CATEGORY_VIEW', category) %}
                                    <a class="btn btn-outline-primary" href="{{ url('category_view', {id: category.id}) }}" title="{{ 'action.show'|trans }}">
                                        {{ 'action.show'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('CATEGORY_EDIT', category) %}
                                    <a class="btn btn-outline-success" href="{{ url('category_edit', {id: category.id}) }}" title="{{ 'action.edit'|trans }}">
                                        {{ 'action.edit'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('CATEGORY_DELETE', category) %}
                                    <a class="btn btn-outline-danger" href="{{ url('category_delete', {id: category.id}) }}" title="{{ 'action.delete'|trans }}">
                                        {{ 'action.delete'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
