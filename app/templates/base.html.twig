<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon" href="{{ asset('profile.png') }}">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
              rel="stylesheet"
              integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
              crossorigin="anonymous">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
              rel="stylesheet">
        <style>
            label {
                font-weight: 700;
            }

            label.required::after {
                content: " *";
                color: red;
            }
            .profile-icon {
                width: 32px;
                height: 32px;
                object-fit: cover;
                border-radius: 50%;
            }
        </style>
    {% endblock %}

</head>
<body>

{# --- Navbar --- #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('dashboard_index') }}">Personal Manager</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'dashboard' %}active{% endif %}" aria-current="page" href="{{ path('dashboard_index') }}">
                            {{ 'nav.dashboard'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'event' %}active{% endif %}" href="{{ path('event_index') }}">
                            {{ 'nav.events'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'contact' %}active{% endif %}" href="{{ path('contact_index') }}">
                            {{ 'nav.contacts'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'category' %}active{% endif %}" href="{{ path('category_index') }}">
                            {{ 'nav.categories'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'tag' %}active{% endif %}" href="{{ path('tag_index') }}">
                            {{ 'nav.tags'|trans }}
                        </a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ 'nav.admin'|trans }}
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" href="{{ path('admin_user_index') }}">{{ 'nav.manage_users'|trans }}</a></li>
                            </ul>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
            <ul class="navbar-nav">
                {% if app.request.attributes.get('_route') != 'app_login' %}
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {% if app.user.avatar is defined and app.user.avatar.filename is defined and app.user.avatar.filename|length %}
                                    <img src="{{ asset(avatars_directory ~ app.user.avatar.filename) }}"
                                         alt="Avatar"
                                         class="rounded-circle"
                                         style="width: 32px; height: 32px; object-fit: cover;">
                                {% else %}
                                    <img src="{{ asset('profile.png') }}" alt="Profil użytkownika" class="profile-icon">
                                {% endif %}
                                {{ app.user.email }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">{{ 'nav.profile'|trans }}</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_change_password') }}">{{ 'nav.change_password'|trans }}</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_logout') }}">
                                        {{ 'action.logout'|trans }}
                                    </a>
                                </li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_login') }}">
                                {{ 'action.login'|trans }}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_register') }}">
                                {{ 'action.register'|trans }}
                            </a>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{# --- Main content area --- #}
<main class="container-fluid py-3">
    <div class="container">
        {% include 'default/_flash_messages.html.twig' %}

        {% block body %}{% endblock %}
    </div>
</main>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
{% endblock %}
</body>
</html>