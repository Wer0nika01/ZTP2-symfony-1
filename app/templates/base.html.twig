<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {% block stylesheets %}
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
              rel="stylesheet"
              integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
              crossorigin="anonymous">

        <!-- Bootstrap Icons -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
              rel="stylesheet">
        <style>
            label {
                font-weight: 700;
            }

            label.required::after {
                content: " *";
                color: red;
            }
        </style>
    {% endblock %}

</head>
<body>
<main role="main" class="container-fluid py-3">
    <div class="container">
        <!-- Header with user info -->
        <div class="d-flex justify-content-end align-items-center mb-3">
            {% if app.request.attributes.get('_route') != 'app_login' %}
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <div class="me-2 d-flex align-items-center gap-2">
                        {% if app.user.avatar is defined and app.user.avatar.filename is defined and app.user.avatar.filename|length %}
                            <img src="{{ asset(avatars_directory ~ app.user.avatar.filename) }}"
                                 alt="Avatar"
                                 class="rounded-circle"
                                 style="width: 32px; height: 32px; object-fit: cover;">
                        {% else %}
                            <i class="bi bi-person-circle fs-4"></i>
                        {% endif %}
                        <a href="{{ path('app_profile') }}" class="text-decoration-none">{{ app.user.email }}</a>
                    </div>
                    <div>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary btn-sm">
                            {{ 'action.logout'|trans }}
                        </a>
                    </div>
                {% else %}
                    <div>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'action.login'|trans }}
                        </a>
                    </div>
                {% endif %}
            {% endif %}
        </div>
        <!-- Flash messages (alerts) -->
        {% include 'default/_flash_messages.html.twig' %}

        <!-- Page-specific content -->
        {% block body %}
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <div>{{ app.user.email }}</div>
                <div>
                    <a href="{{ url('app_logout') }}">{{ 'action.logout'|trans }}</a>
                </div>
            {% else %}
                <div>
                    <a href="{{ url('app_login') }}">{{ 'action.login'|trans }}</a>
                </div>
            {% endif %}
        {% endblock %}
    </div>
</main>

{% block javascripts %}
    <!-- Bootstrap Popper and JS -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
{% endblock %}
</body>
</html>
