{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.event_details'|trans({'%id%': event.id|default('')}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.event_details'|trans({'%id%': event.id|default('')}) }}</h1>
    {% if event is defined and event|length %}
        <dl class="dl-horizontal">
            <dt>{{ 'label.id'|trans }}</dt>
            <dd>{{ event.id }}</dd>
            <dt>{{ 'label.created_at'|trans }}</dt>
            <dd>{{ event.createdAt|format_date('long') }}</dd>
            <dt>{{ 'label.updated_at'|trans }}</dt>
            <dd>{{ event.updatedAt|format_date('long') }}</dd>
            <dt>{{ 'label.title'|trans }}</dt>
            <dd>{{  event.title }}</dd>
            <dt>{{ 'label.comment'|trans }}</dt>
            <dd>
                {% if event.comment is not empty %}
                    {{ event.comment|markdown_to_html }}
                {% else %}
                    <em>{{ 'label.no_comment'|trans }}</em>
                {% endif %}
            </dd>
            <dt>{{ 'label.category'|trans }}</dt>
            <dd>{{  event.category.title }}</dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>
                {% if event.tags is not empty %}
                    {% for tag in event.tags %}
                        <span class="badge bg-secondary">{{ tag.title }}</span>{% if not loop.last %} {% endif %}
                    {% endfor %}
                {% else %}
                    <em>{{ 'label.no_tags'|trans }}</em>
                {% endif %}
            </dd>
            <dt>{{ 'label.status'|trans }}</dt>
            <dd>{{ event.status.getLabel()|trans }}</dd>
        </dl>
        <p>
            <a href="{{ url('event_index') }}" title="{{ 'action.back_to_list'|trans }}">
                {{ 'action.back_to_list'|trans }}
            </a>
        </p>
    {% else %}
        <p>
            {{ 'message.record_not_found'|trans }}
        </p>
    {% endif %}
{% endblock %}