{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.event_details'|trans({'%id%': event.id|default('')}) }}
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.event_details'|trans({'%id%': event.id|default('')}) }}</h1>

        {% if event is defined and event is not null %}
            <dl class="dl-horizontal">
                <dt>{{ 'label.id'|trans }}</dt>
                <dd>{{ event.id }}</dd>
                <dt>{{ 'label.title'|trans }}</dt>
                <dd>{{ event.title }}</dd>
                <dt>{{ 'label.description'|trans }}</dt>
                <dd>
                    {% if event.description is not empty %}
                        {{ event.description|markdown_to_html|raw }}
                    {% else %}
                        <em>{{ 'label.no_description'|trans }}</em>
                    {% endif %}
                </dd>
                <dt>{{ 'label.startTime'|trans }}</dt>
                <dd>{{ event.startTime|format_datetime('medium', 'short', locale='pl') }}</dd>

                <dt>{{ 'label.endTime'|trans }}</dt>
                <dd>
                    {% if event.endTime is not null %}
                        {{ event.endTime|format_datetime('medium', 'short', locale='pl') }}
                    {% else %}
                        <em>{{ 'label.missing'|trans }}</em>
                    {% endif %}
                </dd>

                <dt>{{ 'label.location'|trans }}</dt>
                <dd>
                    {% if event.location is not empty %}
                        {{ event.location }}
                    {% else %}
                        <em>{{ 'label.missing'|trans }}</em>
                    {% endif %}
                </dd>

                <dt>{{ 'label.isAllDay'|trans }}</dt>
                <dd>
                    {% if event.isAllDay %}
                        {{ 'label.yes'|trans }}
                    {% else %}
                        {{ 'label.no'|trans }}
                    {% endif %}
                </dd>

                <dt>{{ 'label.category'|trans }}</dt>
                <dd>
                    {% if event.category is not null %}
                        {{ event.category.title }}
                    {% else %}
                        <em>{{ 'label.no_category'|trans }}</em>
                    {% endif %}
                </dd>

                <dt>{{ 'label.tags'|trans }}</dt>
                <dd>
                    {% if event.tags is not empty %}
                        {% for tag in event.tags %}
                            <span class="badge bg-secondary">{{ tag.title }}</span>{% if not loop.last %} {% endif %}
                        {% endfor %}
                    {% else %}
                        <em>{{ 'label.no_tags'|trans }}</em>
                    {% endif %}
                </dd>

                <dt>{{ 'label.status'|trans }}</dt>
                <dd>
                    {{ event.status.getLabel()|trans }}
                </dd>
            </dl>

            <p>
                <a class="btn btn-secondary" href="{{ url('event_index') }}" title="{{ 'action.back_to_list'|trans }}">
                    {{ 'action.back_to_list'|trans }}
                </a>
                {% if is_granted('EVENT_EDIT', event) %}
                    <a class="btn btn-success" href="{{ url('event_edit', {id: event.id}) }}" title="{{ 'action.edit'|trans }}">
                        {{ 'action.edit'|trans }}
                    </a>
                {% endif %}
                {% if is_granted('EVENT_DELETE', event) %}
                    <a class="btn btn-danger" href="{{ url('event_delete', {id: event.id}) }}" title="{{ 'action.delete'|trans }}">
                        {{ 'action.delete'|trans }}
                    </a>
                {% endif %}
            </p>
        {% else %}
            <p>
                {{ 'message.record_not_found'|trans }}
            </p>
        {% endif %}
    </div>
{% endblock %}