{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.event_list'|trans }}
{% endblock %}

{% block body %}
    {% set showActions = false %}
    {% for event in pagination.items %}
        {% if is_granted('EVENT_VIEW', event) %}
            {% set showActions = true %}
        {% endif %}
    {% endfor %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.event_list'|trans }}</h1>
            <div>
                {% if form.vars.value.category or form.vars.value.status or not form.vars.value.tags.empty %}
                    <a href="{{ path('event_index') }}" class="btn btn-warning me-2">
                        {{ 'action.reset_filters'|trans }}
                    </a>
                {% endif %}
                <a href="{{ path('event_create') }}" class="btn btn-primary">
                    {{ 'action.create'|trans }}
                </a>
            </div>
        </div>

        <div class="mb-4 p-3 border rounded bg-light">
            <h4>{{ 'label.filter_events'|trans }}</h4>
            {{ form_start(form, {'attr': {'class': 'form-inline'}}) }}
            <div class="row g-3">
                <div class="col-md-8 col-lg-6">
                    <div class="mb-3">
                        {{ form_row(form.category, {'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div>
                        {{ form_row(form.status, {'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>
                <div class="col-md-4 col-lg-6">
                    {{ form_row(form.tags, {'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-check-inline'}}) }}
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-info">
                        {{ 'action.filter'|trans }}
                    </button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}

            <div class="text-center mb-3">
                {{ knp_pagination_render(pagination) }}
            </div>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.title'|trans }}</th>
                    <th>{{ 'label.description'|trans }}</th>
                    <th>{{ 'label.startTime'|trans }}</th>
                    <th>{{ 'label.endTime'|trans }}</th>
                    <th>{{ 'label.location'|trans }}</th>
                    <th>{{ 'label.category'|trans }}</th>
                    <th>{{ 'label.tags'|trans }}</th>
                    <th>{{ 'label.status'|trans }}</th>
                    {% if showActions %}
                        <th>{{ 'label.actions'|trans }}</th>
                    {% endif %}

                </tr>
                </thead>
                <tbody>
                {% for event in pagination.items %}
                    <tr>
                        <td>{{ event.title }}</td>
                        <td>
                            {{ event.description|length > 100 ? event.description|slice(0, 100) ~ '...' : event.description }}
                        </td>
                        <td>{{ event.startTime|format_datetime('medium', 'short', locale='pl') }}</td>
                        <td>{{ event.endTime ? event.endTime|format_datetime('medium', 'short', locale='pl') : 'label.missing'|trans }}</td>
                        <td>{{ event.location ?? 'label.missing'|trans }}</td>
                        <td>
                            {% if event.category is not null %}
                                <a class="btn btn-sm btn-outline-primary"
                                   href="{{ path('event_index', {'event_filter[category]' : event.category.id}) }}"
                                   title="Filtruj po kategorii: {{ event.category.title }}">
                                    {{ event.category.title }}
                                </a>
                            {% else %}
                                <em>{{ 'label.no_category'|trans }}</em>
                            {% endif %}
                        </td>
                        <td>
                            {% if event.tags is not empty %}
                                {% for tag in event.tags %}
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="{{ path('event_index', {'event_filter[tags][]' : tag.id}) }}"
                                       title="Filtruj po tagu: {{ tag.name }}">
                                        {{ tag.name }}
                                    </a>
                                {% endfor %}
                            {% else %}
                                <em>{{ 'label.no_tags'|trans }}</em>
                            {% endif %}
                        </td>
                        <td>
                            <a class=" btn {{ event.status.getButtonClass() }}"
                               href="{{ path('event_index', {'event_filter[status]' : event.status.value}) }}"
                               title="Filtruj po statusie: {{ event.status.getLabel()|trans }}">
                                {{ event.status.getLabel()|trans }}
                            </a>
                        </td>
                        {% if showActions %}
                            <td>
                                {% if is_granted('EVENT_VIEW', event) %}
                                    <a class="btn btn-outline-primary" href="{{ url('event_view', {id: event.id}) }}" title="{{ 'action.show'|trans }}">
                                        {{ 'action.show'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('EVENT_EDIT', event) %}
                                    <a class="btn btn-outline-success" href="{{ url('event_edit', {id: event.id}) }}" title="{{ 'action.edit'|trans }}">
                                        {{ 'action.edit'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('EVENT_DELETE', event) %}
                                    <a class="btn btn-outline-danger" href="{{ url('event_delete', {id: event.id}) }}" title="{{ 'action.delete'|trans }}">
                                        {{ 'action.delete'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}