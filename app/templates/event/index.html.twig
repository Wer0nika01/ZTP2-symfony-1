{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.event_list'|trans }}
{% endblock %}

{% block body %}
    {% set showActions = false %}
    {% for event in pagination %}
        {% if is_granted('event_VIEW', event) %}
            {% set showActions = true %}
        {% endif %}
    {% endfor %}
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.event_list'|trans }}</h1>
            {% if app.request.query.get('categoryId') or app.request.query.get('tagId') or app.request.query.get('statusId') %}
                <a href="{{ path('event_index') }}" class="btn btn-warning me-2">
                    {{ 'action.reset_filters'|trans }}
                </a>
            {% endif %}
            <a href="{{ path('event_create') }}" class="btn btn-primary">
                {{ 'action.create'|trans }}
            </a>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}

        <div class="text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.name'|trans }}</th>
                    <th>{{ 'label.created_at'|trans }}</th>
                    <th>{{ 'label.updated_at'|trans }}</th>
                    <th>{{ 'label.category'|trans }}</th>
                    <th>{{ 'label.tags'|trans }}</th>
                    <th>{{ 'label.status'|trans }}</th>
                    {% if showActions %}
                        <th>{{ 'label.actions'|trans }}</th>
                    {% endif %}

                </tr>
                </thead>
                <tbody>
                {% for event in pagination.items %}
                    <tr>
                        <td>{{ event.id }}</td>
                        <td>{{ event.title }}</td>
                        <td>{{ event.createdAt|format_date('long') }}</td>
                        <td>{{ event.updatedAt|format_date('long') }}</td>
                        <td>
                            {% if event.category is not null %}
                                <a class="btn btn-sm btn-outline-primary"
                                   href="{{ url('event_index', {'categoryId' : event.category.id, 'statusId' : event.status.value}) }}">
                                    {{ event.category.title }}
                                </a>
                            {% else %}
                                <em>{{ 'label.no_category'|trans }}</em>
                            {% endif %}
                        </td>
                        <td>
                            {% if event.tags is not empty %}
                                {% for tag in event.tags %}
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="{{ url('event_index', {'tagId' : tag.id, 'statusId' : event.status.value}) }}">
                                        {{ tag.title }}
                                    </a>
                                {% endfor %}
                            {% else %}
                                <em>{{ 'label.no_tags'|trans }}</em>
                            {% endif %}
                        </td>
                        <td>
                            <a class="btn btn-sm {{ event.status.getBadgeClass() }}"
                               href="{{ url('event_index', {'statusId' : event.status.value, 'categoryId' : app.request.query.get('categoryId'), 'tagId' : app.request.query.get('tagId')}) }}">
                                {{ event.status.getLabel()|trans }}
                            </a>
                        </td>
                        {% if showActions %}
                            <td>
                                {% if is_granted('EVENT_VIEW', event) %}
                                    <a class="btn btn-outline-primary" href="{{ url('event_view', {id: event.id}) }}" title="{{ 'action.show'|trans }}">
                                        {{ 'action.show'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('EVENT_EDIT', event) %}
                                    <a class="btn btn-outline-success" href="{{ url('event_edit', {id: event.id}) }}" title="{{ 'action.edit'|trans }}">
                                        {{ 'action.edit'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('EVENT_DELETE', event) %}
                                    <a class="btn btn-outline-danger" href="{{ url('event_delete', {id: event.id}) }}" title="{{ 'action.delete'|trans }}">
                                        {{ 'action.delete'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    {% endif %}
    </div>
{% endblock %}