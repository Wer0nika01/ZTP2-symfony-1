{#
Default template for forms.

parameters:
    - page_title: page title
    - form: form view variable
    - submit_label: label for submit button
#}
{% extends 'base.html.twig' %}

{% block title %}
    {{ page_title }}
{% endblock %}

{% block body %}
    <h1>{{ page_title }}</h1>
    {{ form_start(form) }}
    {% if false == form.vars.valid %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'danger',
            message: 'message.form_error'|trans,
        }%}
    {% endif %}
    {{ form_widget(form) }}
    <div class="d-flex justify-content-between w-100 mt-3 gap-2">
        <input type="submit" value="{{ submit_label }}" class="btn btn-primary flex-grow-1"/>

        {% if back_to_list_path|default(false) %}
            <a href="{{ url(back_to_list_path) }}" class="btn btn-outline-primary flex-grow-1">
                {{ 'action.back_to_list'|trans }}
            </a>
        {% endif %}
    </div>
    {{ form_end(form) }}
{% endblock %}
