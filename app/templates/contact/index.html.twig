{% extends 'base.html.twig' %}

{% block title %}{{ 'title.contact_list'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>{{ 'title.contact_list'|trans }}</h1>
            <div>
                {% if app.request.query.get('company') is not empty %}                    <a href="{{ path('contact_index') }}" class="btn btn-warning me-2">
                        {{ 'action.reset_filters'|trans }}
                    </a>
                {% endif %}
                <a href="{{ path('contact_create') }}" class="btn btn-primary">
                    {{ 'action.create'|trans }}
                </a>
            </div>
        </div>

        {% if pagination.items is empty %}
            {% include 'default/_single_alert_message.html.twig' with {
                type: 'warning',
                message: 'message.empty_list'|trans
            } %}
        {% else %}
            <div class="text-center mb-3">
                {{ knp_pagination_render(pagination, null, {'query': app.request.query.all}) }}
            </div>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>{{ 'label.title'|trans }}</th>
                        <th>{{ 'label.firstName'|trans }}</th>
                        <th>{{ 'label.lastName'|trans }}</th>
                        <th>{{ 'label.email'|trans }}</th>
                        <th>{{ 'label.phone'|trans }}</th>
                        <th>{{ 'label.address'|trans }}</th>
                        <th>{{ 'label.company'|trans }}</th>
                        <th>{{ 'label.jobTitle'|trans }}</th>
                        <th>{{ 'label.notes'|trans }}</th>
                        <th>{{ 'label.actions'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for contact in pagination.items %}
                        <tr>
                            <td>{{ contact.id }}</td>
                            <td>{{ contact.firstName }}</td>
                            <td>{{ contact.lastName }}</td>
                            <td>{{ contact.email ?? 'label.missing'|trans }}</td>
                            <td>{{ contact.phone ?? 'label.missing'|trans }}</td>
                            <td>{{ contact.address ?? 'label.missing'|trans }}</td>
                            <td>
                                {% if contact.company is not empty %}
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="{{ url('contact_index', app.request.query.all|merge({'company': contact.company})) }}"
                                       title="Filtruj po firmie: {{ contact.company }}"> {# Nowy, statyczny tekst tytułu #}
                                        {{ contact.company }}
                                    </a>
                                {% else %}
                                    <em>{{ 'label.missing'|trans }}</em>
                                {% endif %}
                            </td>
                            <td>{{ contact.jobTitle ?? 'label.missing'|trans }}</td>
                            <td>
                                {% if contact.notes is not empty %}
                                    {{ contact.notes|length > 50 ? contact.notes|slice(0, 50) ~ '...' : contact.notes }}
                                {% else %}
                                    {{ 'label.missing'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                {% if is_granted('CONTACT_VIEW', contact) %}
                                    <a class="btn btn-outline-primary btn-sm" href="{{ url('contact_view', {id: contact.id}) }}" title="{{ 'action.show'|trans }}">
                                        {{ 'action.show'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('CONTACT_EDIT', contact) %}
                                    <a class="btn btn-outline-success btn-sm" href="{{ url('contact_edit', {id: contact.id}) }}" title="{{ 'action.edit'|trans }}">
                                        {{ 'action.edit'|trans }}
                                    </a>
                                {% endif %}
                                {% if is_granted('CONTACT_DELETE', contact) %}
                                    <a class="btn btn-outline-danger btn-sm" href="{{ url('contact_delete', {id: contact.id}) }}" title="{{ 'action.delete'|trans }}">
                                        {{ 'action.delete'|trans }}
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}