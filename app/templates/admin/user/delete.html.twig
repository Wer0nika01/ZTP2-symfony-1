{% extends 'base.html.twig' %}

{% block title %}{{ 'title.delete_user'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.delete_user'|trans }}</h1>

    {% if user is defined and user is not null %}
    <table class="table table-striped table-hover">
        <tbody>
        <tr>
            <th>{{ 'label.id'|trans }}</th>
            <td>{{ user.id }}</td>
        </tr>
        <tr>
            <th>{{ 'label.email'|trans }}</th>
            <td>{{ user.email }}</td>
        </tr>
        <tr>
            <th>{{ 'label.roles'|trans }}</th>
            <td>{{ user.roles|join(', ') }}</td>
        </tr>
        {% if user.firstName is defined and user.firstName is not empty %}
            <tr>
                <th>{{ 'label.first_name'|trans }}</th>
                <td>{{ user.firstName }}</td>
            </tr>
        {% endif %}
        {% if user.lastName is defined and user.lastName is not empty %}
            <tr>
                <th>{{ 'label.last_name'|trans }}</th>
                <td>{{ user.lastName }}</td>
            </tr>
        {% endif %}
        {% if user.avatar is defined and user.avatar is not null and user.avatar.filename is defined and user.avatar.filename|length %}
            <tr>
                <th>{{ 'label.avatar'|trans }}</th>
                <td>
                    <img src="{{ asset(avatars_directory ~ user.avatar.filename) }}"
                         alt="{{ 'label.user_avatar'|trans }}"
                         class="img-thumbnail" style="max-width: 150px; height: auto;">
                </td>
            </tr>
        {% endif %}
        </tbody>
    </table>
    {% endif %}

    {{ form_start(form) }}
    <div class="d-flex justify-content-between w-100 mt-3 gap-2">
        <button class="btn btn-danger flex-grow-1" type="submit">{{ 'action.delete'|trans }}</button>
        <a href="{{ path('admin_user_index') }}" class="btn btn-secondary flex-grow-1">
            {{ 'action.cancel'|trans }}
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}
