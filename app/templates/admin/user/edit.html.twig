{% extends 'base.html.twig' %}

{% block title %}{{ 'title.edit_user'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.edit_user'|trans }}</h1>

        {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="d-flex justify-content-between w-100 mt-3 gap-2">
            <button class="btn btn-primary flex-grow-1">{{ 'action.save'|trans }}</button>
            <a href="{{ path('admin_user_index') }}" class="btn btn-outline-primary flex-grow-1">
                {{ 'action.back_to_list'|trans }}
            </a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}