{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user'|trans }}{% endblock %}


{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.user'|trans }}</h1>
        <div class="navigation">
            {{ knp_pagination_render(pagination) }}
        </div>
        <table class="table">
            <thead>
            <tr>
                <th>{{ 'label.email'|trans }}</th>
                <th>{{ 'label.roles'|trans }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for user in pagination %}
                <tr>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>
                        <a href="{{ path('admin_user_view', {id: user.id}) }}" class="btn btn-outline-primary">
                            {{ 'action.view'|trans }}
                        </a>
                        <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-outline-success">
                            {{ 'action.edit'|trans }}
                        </a>
                        <a href="{{ path('admin_user_delete', {id: user.id}) }}" class="btn btn-outline-danger">
                            {{ 'action.delete'|trans }}
                        </a>
                        <form method="post" action="{{ path('admin_user_toggle_block', {id: user.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-block' ~ user.id) }}">
                            <button type="submit" class="btn
                                {{ user.isBlocked ? 'btn-warning' : 'btn-outline-warning' }}">
                                {{ user.isBlocked ? 'action.unblock'|trans : 'action.block'|trans }}
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">{{ 'message.empty_list'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}