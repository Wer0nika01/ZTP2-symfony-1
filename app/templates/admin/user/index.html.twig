{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_list'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ 'title.user_list'|trans }}</h1>

        {% if users is empty %}
            <div class="alert alert-warning">{{ 'message.no_users'|trans }}</div>
        {% else %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ 'label.id'|trans }}</th>
                    <th>{{ 'label.email'|trans }}</th>
                    <th>{{ 'label.roles'|trans }}</th>
                    <th>{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>
                            <a href="{{ path('admin_user_view', {id: user.id}) }}" class="btn btn-outline-primary btn-sm">
                                {{ 'action.show'|trans }}
                            </a>
                            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-outline-success btn-sm">
                                {{ 'action.edit'|trans }}
                            </a>
                            <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" style="display:inline;" onsubmit="return confirm('{{ 'message.confirm_delete'|trans }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button class="btn btn-outline-danger btn-sm">{{ 'action.delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
